// ===============================
// Methane (CH4) Molecule Model
// Unit 5 Assignment – Three.js
// ===============================

// Create the scene
const scene = new THREE.Scene();
scene.background = new THREE.Color(0x000000);

// Create the camera
const camera = new THREE.PerspectiveCamera(
  75,
  window.innerWidth / window.innerHeight,
  0.1,
  1000
);
camera.position.set(0, 5, 10);

// Create the renderer
const renderer = new THREE.WebGLRenderer({ antialias: true });
renderer.setSize(window.innerWidth, window.innerHeight);
renderer.shadowMap.enabled = true;
document.body.appendChild(renderer.domElement);

// ===============================
// Lighting
// ===============================

// Directional light for shadows
const light = new THREE.DirectionalLight(0xffffff, 1);
light.position.set(5, 10, 5);
light.castShadow = true;
scene.add(light);

// Ambient light for softer shading
scene.add(new THREE.AmbientLight(0x404040));

// ===============================
// Green Plane (Ground)
// ===============================

const planeGeometry = new THREE.PlaneGeometry(20, 20);
const planeMaterial = new THREE.MeshStandardMaterial({ color: 0x00aa00 });
const plane = new THREE.Mesh(planeGeometry, planeMaterial);

plane.rotation.x = -Math.PI / 2;
plane.position.y = -2;
plane.receiveShadow = true;
scene.add(plane);

// ===============================
// Methane Molecule Group
// ===============================

const molecule = new THREE.Group();
scene.add(molecule);

// Carbon atom (Red)
const carbonGeometry = new THREE.SphereGeometry(1, 32, 32);
const carbonMaterial = new THREE.MeshStandardMaterial({ color: 0xff0000 });
const carbon = new THREE.Mesh(carbonGeometry, carbonMaterial);
carbon.castShadow = true;
molecule.add(carbon);

// Hydrogen atom material (Blue)
const hydrogenMaterial = new THREE.MeshStandardMaterial({ color: 0x0000ff });

// Bond material (White with emissive gray)
const bondMaterial = new THREE.MeshStandardMaterial({
  color: 0xffffff,
  emissive: 0xaaaaaa
});

// Hydrogen positions (tetrahedral geometry)
const positions = [
  new THREE.Vector3(2, 2, 2),
  new THREE.Vector3(-2, -2, 2),
  new THREE.Vector3(-2, 2, -2),
  new THREE.Vector3(2, -2, -2)
];

// Create hydrogen atoms and bonds
positions.forEach(pos => {
  // Hydrogen atom
  const hydrogen = new THREE.Mesh(
    new THREE.SphereGeometry(0.5, 32, 32),
    hydrogenMaterial
  );
  hydrogen.position.copy(pos);
  hydrogen.castShadow = true;
  molecule.add(hydrogen);

  // Bond (Cylinder)
  const bondGeometry = new THREE.CylinderGeometry(0.15, 0.15, pos.length(), 16);
  const bond = new THREE.Mesh(bondGeometry, bondMaterial);

  // Position bond halfway between carbon and hydrogen
  bond.position.copy(pos.clone().multiplyScalar(0.5));

  // Align bond toward hydrogen atom
  bond.lookAt(pos);
  bond.rotateX(Math.PI / 2);

  bond.castShadow = true;
  molecule.add(bond);
});

// ===============================
// Mouse Controls (Rotate Molecule)
// ===============================

const controls = new THREE.OrbitControls(camera, renderer.domElement);
controls.enablePan = false;     // Prevent moving scene
controls.enableZoom = true;
controls.target.set(0, 0, 0);
controls.update();

// ===============================
// Animation Loop
// ===============================

function animate() {
  requestAnimationFrame(animate);

  // Rotate ONLY the molecule
  molecule.rotation.y += 0.01;

  renderer.render(scene, camera);
}

animate();

// ===============================
// Handle Window Resize
// ===============================

window.addEventListener('resize', () => {
  camera.aspect = window.innerWidth / window.innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(window.innerWidth, window.innerHeight);
});
